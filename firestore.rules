rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email == 'jhonaraujo2009@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail()
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['SUPER_ADMIN', 'admin']
        )
      );
    }

    function isValidPackageCoins(amount) {
      return amount is int && amount >= 10 && amount <= 100000;
    }

    function isValidPackagePrice(coins, amountUSD) {
      return isValidPackageCoins(coins)
        && amountUSD is number
        && amountUSD >= 0.5
        && amountUSD <= 10000;
    }

    function economyMinWithdraw() {
      return exists(/databases/$(database)/documents/appConfig/economy)
        ? get(/databases/$(database)/documents/appConfig/economy).data.get('minWithdrawalDiamonds', 500)
        : 500;
    }

    function economyNetRate() {
      return exists(/databases/$(database)/documents/appConfig/economy)
        ? get(/databases/$(database)/documents/appConfig/economy).data.get('diamondToNetUSDRate', 0.006)
        : 0.006;
    }

    function economyCoinsPerDiamond() {
      return exists(/databases/$(database)/documents/appConfig/economy)
        ? get(/databases/$(database)/documents/appConfig/economy).data.get('coinsPerDiamond', 2)
        : 2;
    }

    function isValidGiftValue(amount) {
      return amount in [10, 25, 50, 150, 500];
    }

    function isValidBoostCost(spent) {
      return spent is int && spent >= 10 && spent <= 5000;
    }

    function isValidProCost(spent) {
      return spent is int && spent >= 10 && spent <= 10000;
    }

    function boostFieldsUnchanged() {
      return request.resource.data.get('isBoosted', false) == resource.data.get('isBoosted', false)
        && request.resource.data.get('boostExpiresAt', null) == resource.data.get('boostExpiresAt', null)
        && request.resource.data.get('boostCountry', null) == resource.data.get('boostCountry', null);
    }

    function proFieldsUnchanged() {
      return request.resource.data.get('isPro', false) == resource.data.get('isPro', false)
        && request.resource.data.get('proExpiresAt', null) == resource.data.get('proExpiresAt', null)
        && request.resource.data.get('proPlanId', null) == resource.data.get('proPlanId', null);
    }

    function totalSpentUnits() {
      return (resource.data.get('diamonds', 0) - request.resource.data.get('diamonds', 0))
        + (resource.data.get('coins', 0) - request.resource.data.get('coins', 0));
    }

    // ==================== USERS ====================
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && (
          request.resource.data.role == 'user'
          || (isSuperAdminEmail() && request.resource.data.role == 'SUPER_ADMIN')
        )
        && request.resource.data.coins == 0
        && request.resource.data.get('diamonds', 0) == 0
        && request.resource.data.earningsDiamonds == 0
        && request.resource.data.get('pendingWithdrawalDiamonds', 0) == 0
        && request.resource.data.get('totalWithdrawnUSD', 0) == 0
        && request.resource.data.likesCount == 0
        && request.resource.data.giftsReceivedCount == 0
        && request.resource.data.isBoosted == false
        && request.resource.data.get('isBanned', false) == false
        && request.resource.data.get('verifiedBadge', false) == false
        && request.resource.data.get('accountStatus', 'active') == 'active';

      allow update: if isAdmin()
        || (
          // Actualización del propio dueño (nunca puede auto-aprobar Check Azul ni quitarse un baneo)
          isOwner(userId)
          && resource.data.get('isBanned', false) == false
          && request.resource.data.get('isBanned', false) == false
          && request.resource.data.get('accountStatus', 'active') == resource.data.get('accountStatus', 'active')
          && request.resource.data.get('verifiedBadge', false) == resource.data.get('verifiedBadge', false)
          && (
            request.resource.data.get('verificationStatus', 'none') == resource.data.get('verificationStatus', 'none')
            || request.resource.data.get('verificationStatus', 'none') == 'pending'
          )
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('totalWithdrawnUSD', 0) == resource.data.get('totalWithdrawnUSD', 0)
          && request.resource.data.likesCount == resource.data.likesCount
          && request.resource.data.giftsReceivedCount == resource.data.giftsReceivedCount
          && request.resource.data.get('giftCounts', {}) == resource.data.get('giftCounts', {})
          && (
            (
              // Operación estándar: perfil, reserva de retiro o gasto válido de monedas (nunca auto-recarga gratis)
              (
                (
                  request.resource.data.earningsDiamonds == resource.data.earningsDiamonds
                  && request.resource.data.get('pendingWithdrawalDiamonds', 0) == resource.data.get('pendingWithdrawalDiamonds', 0)
                )
                || (
                  request.resource.data.earningsDiamonds < resource.data.earningsDiamonds
                  && request.resource.data.earningsDiamonds >= 0
                  && (request.resource.data.earningsDiamonds + request.resource.data.get('pendingWithdrawalDiamonds', 0))
                     == (resource.data.earningsDiamonds + resource.data.get('pendingWithdrawalDiamonds', 0))
                )
              )
              && request.resource.data.coins <= resource.data.coins
              && request.resource.data.coins >= 0
              && request.resource.data.get('diamonds', 0) <= resource.data.get('diamonds', 0)
              && request.resource.data.get('diamonds', 0) >= 0
              && (
                boostFieldsUnchanged()
                || isValidBoostCost(totalSpentUnits())
              )
              && (
                proFieldsUnchanged()
                || isValidProCost(totalSpentUnits())
              )
            )
            || (
              // Canje atómico de diamantes ganados por regalos -> diamantes disponibles para usar en la app (1:1)
              boostFieldsUnchanged()
              && proFieldsUnchanged()
              && request.resource.data.coins == resource.data.coins
              && request.resource.data.earningsDiamonds < resource.data.earningsDiamonds
              && request.resource.data.earningsDiamonds >= 0
              && request.resource.data.get('pendingWithdrawalDiamonds', 0) == resource.data.get('pendingWithdrawalDiamonds', 0)
              && request.resource.data.get('diamonds', 0) > resource.data.get('diamonds', 0)
              && (request.resource.data.get('diamonds', 0) - resource.data.get('diamonds', 0))
                 <= (resource.data.earningsDiamonds - request.resource.data.earningsDiamonds) * economyCoinsPerDiamond()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['earningsDiamonds', 'diamonds', 'updatedAt'])
            )
            || (
              // Canje atómico de diamantes comprados (diamonds) -> monedas internas (compatibilidad)
              boostFieldsUnchanged()
              && proFieldsUnchanged()
              && request.resource.data.earningsDiamonds == resource.data.earningsDiamonds
              && request.resource.data.get('pendingWithdrawalDiamonds', 0) == resource.data.get('pendingWithdrawalDiamonds', 0)
              && request.resource.data.get('diamonds', 0) < resource.data.get('diamonds', 0)
              && request.resource.data.get('diamonds', 0) >= 0
              && request.resource.data.coins > resource.data.coins
              && (request.resource.data.coins - resource.data.coins)
                 <= (resource.data.get('diamonds', 0) - request.resource.data.get('diamonds', 0)) * economyCoinsPerDiamond()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diamonds', 'coins', 'updatedAt'])
            )
            || (
              // Canje atómico de diamantes ganados por regalos -> monedas internas (compatibilidad)
              boostFieldsUnchanged()
              && proFieldsUnchanged()
              && request.resource.data.get('diamonds', 0) == resource.data.get('diamonds', 0)
              && request.resource.data.earningsDiamonds < resource.data.earningsDiamonds
              && request.resource.data.earningsDiamonds >= 0
              && request.resource.data.get('pendingWithdrawalDiamonds', 0) == resource.data.get('pendingWithdrawalDiamonds', 0)
              && request.resource.data.coins > resource.data.coins
              && (request.resource.data.coins - resource.data.coins)
                 <= (resource.data.earningsDiamonds - request.resource.data.earningsDiamonds) * economyCoinsPerDiamond()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['earningsDiamonds', 'coins', 'updatedAt'])
            )
          )
        )
        || (
          // Otro usuario enviando un Like real nuevo (+1 likesCount vinculado a creación de likes/{from}_{to})
          isSignedIn()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
          && request.resource.data.likesCount == resource.data.get('likesCount', 0) + 1
          && !exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + userId))
          && existsAfter(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + userId))
        )
        || (
          // Otro usuario enviando un Regalo: exige descuento atómico exacto en Diamantes disponibles del emisor
          isSignedIn()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['giftsReceivedCount', 'earningsDiamonds', 'giftCounts', 'updatedAt'])
          && request.resource.data.giftsReceivedCount == resource.data.get('giftsReceivedCount', 0) + 1
          && request.resource.data.giftCounts is map
          && isValidGiftValue(request.resource.data.earningsDiamonds - resource.data.get('earningsDiamonds', 0))
          && (
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('diamonds', 0)
            + getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coins', 0)
          )
             == (
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('diamonds', 0)
               + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coins', 0)
             )
                - (request.resource.data.earningsDiamonds - resource.data.get('earningsDiamonds', 0))
        );

      allow delete: if false;

      // ==================== DATOS PRIVADOS DEL USUARIO (COBRO Y DESBLOQUEOS) ====================
      // Estrictamente privados por uid: cuentas de Binance/Zinli/Pago Móvil y desbloqueos de anuncios/monedas.
      // Ningún otro usuario puede leer ni escribir estos documentos.
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ==================== LIKES ====================
    match /likes/{likeId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.toUserId;
      allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }

    // ==================== MATCHES & CHAT PRIVADO 1-A-1 ====================
    // Privacidad estricta: únicamente los 2 participantes del chat pueden leer o enviar mensajes.
    match /matches/{matchId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && matchId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (
            (exists(/databases/$(database)/documents/matches/$(matchId))
              && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participants)
            || request.auth.uid in getAfter(/databases/$(database)/documents/matches/$(matchId)).data.participants
          );
      }
    }

    // ==================== SOLICITUDES DE RECARGA MANUAL ====================
    match /paymentRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && isValidPackageCoins(request.resource.data.get('diamondsToCredit', request.resource.data.get('coinsToCredit', 0)))
        && isValidPackagePrice(request.resource.data.get('diamondsToCredit', request.resource.data.get('coinsToCredit', 0)), request.resource.data.amountUSD);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==================== TRANSACCIONES AUTOMÁTICAS / ADMIN ====================
    match /paymentTransactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin()
        && isValidPackageCoins(request.resource.data.get('diamondsCredited', request.resource.data.get('coinsCredited', 0)));
      allow update, delete: if false;
    }

    // ==================== SOLICITUDES DE RETIRO DE GANANCIAS ====================
    match /withdrawalRequests/{withdrawalId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amountDiamonds is int
        && request.resource.data.amountDiamonds >= economyMinWithdraw()
        && request.resource.data.netPayoutUSD is number
        && request.resource.data.netPayoutUSD > 0
        && request.resource.data.netPayoutUSD <= (request.resource.data.amountDiamonds * economyNetRate() + 0.02);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==================== REGISTRO DE REGALOS ====================
    match /giftTransactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && isValidGiftValue(request.resource.data.coinsCost);
      allow update, delete: if false;
    }

    // ==================== PUBLICIDAD RECOMPENSADA (IMPRESIONES) ====================
    match /adImpressions/{impId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.purpose in ['reveal_like', 'unlock_chat'];
      allow update, delete: if false;
    }

    // ==================== REPORTES DE SEGURIDAD ====================
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==================== CONFIGURACIÓN GLOBAL DE LA APP ====================
    // Lectura para usuarios autenticados (precios vigentes de diamantes/paquetes), escritura exclusiva SUPER_ADMIN.
    match /appConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
