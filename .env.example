# Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Cloudinary Unsigned Upload Configuration
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# Checkout URLs (LemonSqueezy / PayPal) - Opcional para producción
VITE_LEMONSQUEEZY_CHECKOUT_BASE=https://tu-tienda.lemonsqueezy.com/checkout/buy
VITE_PAYPAL_CHECKOUT_BASE=https://www.paypal.com/paypalme/tuempresa

# Datos de cobro directo de la empresa (opcional, sobreescriben valores demo)
VITE_BINANCE_PAY_ID=384920194
VITE_ZINLI_EMAIL=pagos@conoscamosnos.app
VITE_MERU_ACCOUNT=MERU-USD-8849201
VITE_PAGO_MOVIL_INFO=0414-0000000 | V-12345678 | Banesco (0134)

# Seguridad de Pagos (Mantener false en producción para impedir recargas demo a usuarios comunes)
VITE_ENABLE_DEMO_PAYMENTS=false

# Publicidad Recompensada (Rewarded Ads) para ver Likes y desbloquear Chats gratis
# Opciones de VITE_AD_PROVIDER: monetag | adsense_h5 | adsterra | custom_url | preview
VITE_AD_PROVIDER=monetag
VITE_AD_DURATION_SECONDS=8
VITE_ADSENSE_CLIENT=
VITE_MONETAG_ZONE_ID=311878
VITE_MONETAG_SCRIPT_SRC=https://quge5.com/88/tag.min.js
VITE_ADSTERRA_DIRECT_LINK=
VITE_CUSTOM_SPONSOR_URL=

# ==================== BACKEND / API DE PAGOS (NO USAR PREFIJO VITE_) ====================
# Credenciales de Firebase Admin SDK (JSON completo en 1 línea o variables separadas)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Secretos criptográficos de Webhooks y API de Pagos (NowPayments)
# NOTA: NOWPAYMENTS_API_KEY y NOWPAYMENTS_IPN_SECRET van SOLO en Vercel / .env local (nunca en GitHub)
NOWPAYMENTS_API_KEY=tu_nowpayments_api_key
VITE_NOWPAYMENTS_PUBLIC_KEY=tu_nowpayments_public_key
NOWPAYMENTS_IPN_SECRET=tu_nowpayments_ipn_secret
API_PORT=4000
